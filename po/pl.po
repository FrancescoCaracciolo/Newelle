msgstr "Zachowaj enkodery tekstu CLIP w pamięci CPU (--clip-on-cpu)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:965
msgid "Keep VAE on CPU"
msgstr "Zachowaj VAE w CPU"

