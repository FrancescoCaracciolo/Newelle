#: src/workspaces.py:483
msgid "Switch workspaces before deleting the active workspace."
msgstr "Przełącz się na inny obszar roboczy, zanim usuniesz aktywny."

#: src/workspaces.py:530 src/workspaces.py:537
msgid "Finish or stop active work before changing workspaces."
msgstr "Zakończ lub zatrzymaj bieżące zadanie przed zmianą obszaru roboczego."

#: src/workspaces.py:535
msgid "Wait for the workspace window to finish loading."
msgstr "Poczekaj, aż okno obszaru roboczego zakończy ładowanie."

#: src/workspaces.py:539
msgid "Close this workspace's window before deleting it."
msgstr "Zamknij okno tego obszaru roboczego przed jego usunięciem."

