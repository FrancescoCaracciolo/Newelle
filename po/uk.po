#: src/handlers/websearch/outcrawl_handler.py:19
#: src/handlers/websearch/tavily.py:21
#: src/handlers/websearch/tinyfish_handler.py:14
msgid "Max Results"
msgstr "Максимум результатів"

#: src/handlers/memory/agentic_memory_handler.py:73
