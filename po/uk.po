"прискоренням"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:679
msgid "Enable hardware acceleration (requires GPU backend)"
msgstr "Увімкнути апаратне прискорення (потрібна підтримка GPU)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:687
msgid "Use System sd-cli"
msgstr "Використовувати системний sd-cli"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:688
msgid ""
"Use system-installed sd-cli instead of built-in (requires sd-cli on host and "
"sandbox escape)"
msgstr ""
"Використовувати встановлений у системі sd-cli замість вбудованого (потрібен "
"sd-cli на хості та вихід із пісочниці)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:696
msgid "Rebuild or re-download stable-diffusion.cpp"
msgstr "Перезібрати або повторно завантажити stable-diffusion.cpp"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:706
msgid "Use sd-server"
msgstr "Використовувати sd-server"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:707
msgid ""
"Use the HTTP server (sd-server) instead of the CLI (sd-cli) for image "
"generation. The server is faster for multiple generations but uses more "
"memory."
msgstr ""
"Для генерування зображень використовувати HTTP-сервер (sd-server) замість "
"CLI (sd-cli). Сервер швидше виконує кілька генерацій, але використовує "
"більше пам’яті."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:714
msgid "Server Port"
msgstr "Порт сервера"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:715
msgid "Port for the sd-server HTTP server"
msgstr "Порт HTTP-сервера sd-server"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:724
msgid "Generation Settings"
msgstr "Налаштування генерування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:725
msgid "Configure image generation parameters"
msgstr "Налаштуйте параметри генерування зображень"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:728
msgid "Image width in pixels"
msgstr "Ширина зображення в пікселях"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:732
msgid "Image height in pixels"
msgstr "Висота зображення в пікселях"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:736
msgid "Steps"
msgstr "Кроки"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:736
msgid "Number of sampling steps"
msgstr "Кількість кроків семплювання"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:740
msgid "CFG Scale"
msgstr "Масштаб CFG"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:740
msgid "Unconditional guidance scale"
msgstr "Масштаб безумовного керування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:744
msgid "RNG seed (-1 for random)"
msgstr "Зерно генератора випадкових чисел (-1 — випадкове)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:749
msgid "Sampling Method"
msgstr "Метод семплювання"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:750
msgid "Sampler to use for generation"
msgstr "Семплер для генерування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:757
msgid ""
"Template for positive prompt. [input] will be replaced with the user prompt."
msgstr ""
"Шаблон позитивного промпту. [input] буде замінено на промпт користувача."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:762
msgid "Negative Prompt Template"
msgstr "Шаблон негативного промпту"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:763
msgid ""
"Template for negative prompt. [input] will be replaced with the positive "
"prompt."
msgstr ""
"Шаблон негативного промпту. [input] буде замінено на позитивний промпт."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:768
msgid "CLIP Skip"
msgstr "Пропуск CLIP"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:769
msgid ""
"Ignore last layers of CLIP network; 1 ignores none, 2 ignores one layer. <= "
"0 uses model default (1 for SD1.x, 2 for SD2.x)"
msgstr ""
"Ігнорувати останні шари мережі CLIP; 1 — не ігнорувати жодного, 2 — "
"ігнорувати один шар. Значення <= 0 використовує типове значення моделі (1 "
"для SD1.x, 2 для SD2.x)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:780
msgid "LoRA Settings"
msgstr "Налаштування LoRA"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:781
msgid ""
"Configure LoRA adapters. Place LoRA files in the folder below and reference "
"them in your prompt with <lora:filename:multiplier>."
msgstr ""
"Налаштуйте адаптери LoRA. Розмістіть файли LoRA у папці нижче та вказуйте їх "
"у промпті за допомогою <lora:filename:multiplier>."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:785
msgid "Enable LoRA"
msgstr "Увімкнути LoRA"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:786
msgid "Enable LoRA support by passing --lora-model-dir to sd-cli/sd-server"
msgstr ""
"Увімкнути підтримку LoRA, передавши --lora-model-dir у sd-cli/sd-server"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:792
msgid "LoRA Folder"
msgstr "Папка LoRA"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:793
msgid "Directory containing LoRA weights (.safetensors, .ckpt)"
msgstr "Папка з вагами LoRA (.safetensors, .ckpt)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:809
msgid "Enable Image Editing"
msgstr "Увімкнути редагування зображень"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:810
msgid ""
"Enable the edit_image tool. Requires a downloaded image-edit variant from "
"the Model Library (Qwen Image Edit, Qwen Image 2.1 Edit, LongCat Edit, Boogu "
"Edit, LLaDA Edit, or Kontext)."
msgstr ""
"Увімкнути інструмент edit_image. Потрібен завантажений варіант для "
"редагування зображень із бібліотеки моделей (Qwen Image Edit, Qwen Image 2.1 "
"Edit, LongCat Edit, Boogu Edit, LLaDA Edit або Kontext)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:820
msgid "Image Editing Settings"
msgstr "Налаштування редагування зображень"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:821
msgid ""
"Configure the image-edit model, its text encoders and editing-specific "
"overrides."
msgstr ""
"Налаштуйте модель для редагування зображень, її текстові енкодери та "
"специфічні для редагування параметри."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:825
msgid "Edit Model"
msgstr "Модель для редагування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:826
msgid ""
"Stable Diffusion model to use for image editing. Pick a downloaded image-"
"edit variant or a custom file."
msgstr ""
"Модель Stable Diffusion для редагування зображень. Виберіть завантажений "
"варіант для редагування зображень або власний файл."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:834
msgid "Edit VAE"
msgstr "VAE для редагування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:835
msgid ""
"Path to the VAE used by the image-edit model (--vae). Leave empty to use the "
"model default or the variant manifest."
msgstr ""
"Шлях до VAE, який використовує модель для редагування зображень (--vae). "
"Залиште порожнім, щоб використовувати типове значення моделі або маніфест "
"варіанта."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:841
msgid "Edit LLM"
msgstr "LLM для редагування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:842
msgid "Path to the LLM text encoder (--llm) used by the image-edit model."
msgstr ""
"Шлях до текстового енкодера LLM (--llm), який використовує модель для "
"редагування зображень."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:848
msgid "Edit LLM Vision Projector"
msgstr "Візуальний проєктор LLM для редагування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:849
msgid ""
"Path to the vision projector file (--llm_vision) used by Qwen Image Edit "
"2509, Qwen Image 2.1 Edit, LongCat Edit and Boogu Edit."
msgstr ""
"Шлях до файлу візуального проєктора (--llm_vision), який використовують Qwen "
"Image Edit 2509, Qwen Image 2.1 Edit, LongCat Edit і Boogu Edit."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:855
msgid "Edit: Qwen Image Zero Cond T (2511)"
msgstr "Редагування: Qwen Image Zero Cond T (2511)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:856
msgid ""
"Enable zero_cond_t for Qwen Image Edit (--qwen-image-zero-cond-t). Required "
"for the 2511 variant for good results."
msgstr ""
"Увімкнути zero_cond_t для Qwen Image Edit (--qwen-image-zero-cond-t). Для "
"якісних результатів у варіанті 2511 це обов’язково."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:861
msgid "Edit Extra CLI Arguments"
msgstr "Додаткові аргументи CLI для редагування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:862
msgid ""
"Additional command-line arguments passed verbatim to sd-cli for image "
"editing. One per line."
msgstr ""
"Додаткові аргументи командного рядка, що передаються без змін у sd-cli для "
"редагування зображень. По одному на рядок."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:874
msgid ""
"Override VAE, LLM and text encoder paths and tune low-VRAM / model-specific "
"CLI flags."
msgstr ""
"Перевизначте шляхи до VAE, LLM і текстових енкодерів та налаштуйте параметри "
"CLI для низького споживання VRAM або конкретної моделі."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:878
msgid "VAE"
msgstr "VAE"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:879
msgid ""
"Path to standalone VAE model (overrides --vae). Leave empty to use the model "
"default or the variant manifest."
msgstr ""
"Шлях до окремої моделі VAE (перевизначає --vae). Залиште порожнім, щоб "
"використовувати типове значення моделі або маніфест варіанта."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:885
msgid "LLM (Qwen / Mistral / Gemma / Ovis)"
msgstr "LLM (Qwen / Mistral / Gemma / Ovis)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:886
msgid ""
"Path to the LLM text encoder (--llm) used by Qwen Image, FLUX.2, Z-Image, "
"LTX-2, Ovis, Anima, Krea2, ERNIE, LongCat, Boogu, LLaDA."
msgstr ""
"Шлях до текстового енкодера LLM (--llm), який використовують Qwen Image, "
"FLUX.2, Z-Image, LTX-2, Ovis, Anima, Krea2, ERNIE, LongCat, Boogu, LLaDA."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:892
msgid "CLIP-L"
msgstr "CLIP-L"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:893
msgid ""
"Path to the CLIP-L text encoder (--clip_l) used by SD3.5, FLUX.1, Kontext."
msgstr ""
"Шлях до текстового енкодера CLIP-L (--clip_l), який використовують SD3.5, "
"FLUX.1, Kontext."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:899
msgid "CLIP-G"
msgstr "CLIP-G"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:900
msgid "Path to the CLIP-G text encoder (--clip_g) used by SD3.5."
msgstr ""
"Шлях до текстового енкодера CLIP-G (--clip_g), який використовує SD3.5."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:906
msgid "T5XXL"
msgstr "T5XXL"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:907
msgid ""
"Path to the T5XXL text encoder (--t5xxl) used by FLUX.1, Kontext, Chroma, "
"SD3.5, MiniT2I."
msgstr ""
"Шлях до текстового енкодера T5XXL (--t5xxl), який використовують FLUX.1, "
"Kontext, Chroma, SD3.5, MiniT2I."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:913
msgid "Tokenizer JSON"
msgstr "JSON токенізатора"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:914
msgid ""
"Path to an external Hugging Face tokenizer.json (--tokenizer) used by LLaDA-"
"Image and similar models."
msgstr ""
"Шлях до зовнішнього tokenizer.json Hugging Face (--tokenizer), який "
"використовують LLaDA-Image та подібні моделі."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:920
msgid "Video VAE"
msgstr "Відео VAE"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:921
msgid "Path to the video VAE (used as --vae for LTX-2)."
msgstr "Шлях до відео VAE (використовується як --vae для LTX-2)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:927
msgid "Audio VAE"
msgstr "Аудіо VAE"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:928
msgid "Path to the audio VAE (--audio-vae) used by LTX-2."
msgstr "Шлях до аудіо VAE (--audio-vae), який використовує LTX-2."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:934
msgid "Embeddings Connectors"
msgstr "Конектори векторних представлень"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:935
msgid ""
"Path to the embeddings connectors safetensors (--embeddings-connectors) used "
"by LTX-2."
msgstr ""
"Шлях до файлу safetensors із конекторами векторних представлень (--"
"embeddings-connectors), який використовує LTX-2."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:941
msgid "Offload to CPU"
msgstr "Вивантажувати в CPU"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:942
msgid ""
"Place weights in RAM and load them into VRAM on demand (--offload-to-cpu)."
msgstr ""
"Зберігати ваги в RAM і завантажувати їх у VRAM за потреби (--offload-to-cpu)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:947
msgid "Diffusion Flash Attention"
msgstr "Flash Attention для дифузії"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:948
msgid "Use flash attention in the diffusion model (--diffusion-fa)."
msgstr "Використовувати Flash Attention у дифузійній моделі (--diffusion-fa)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:953
msgid "VAE Tiling"
msgstr "Розбиття VAE на плитки"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:954
msgid "Process VAE in tiles to reduce memory usage (--vae-tiling)."
msgstr ""
"Обробляти VAE плитками, щоб зменшити використання пам’яті (--vae-tiling)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:959
msgid "Keep CLIP on CPU"
msgstr "Залишати CLIP у CPU"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:960
msgid "Keep CLIP text encoders in CPU memory (--clip-on-cpu)."
msgstr "Зберігати текстові енкодери CLIP у пам’яті CPU (--clip-on-cpu)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:965
msgid "Keep VAE on CPU"
msgstr "Залишати VAE у CPU"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:966
msgid "Keep VAE in CPU memory (--vae-on-cpu)."
msgstr "Зберігати VAE у пам’яті CPU (--vae-on-cpu)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:971
msgid "Chroma: Disable DiT Mask"
msgstr "Chroma: вимкнути маску DiT"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:972
msgid "Disable DiT mask for Chroma (--chroma-disable-dit-mask)."
msgstr "Вимкнути маску DiT для Chroma (--chroma-disable-dit-mask)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:977
msgid "Chroma: Enable T5 Mask"
msgstr "Chroma: увімкнути маску T5"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:978
msgid "Enable T5 mask for Chroma (--chroma-enable-t5-mask)."
msgstr "Увімкнути маску T5 для Chroma (--chroma-enable-t5-mask)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:983
msgid "Qwen Image: Zero Cond T"
msgstr "Qwen Image: нульове Cond T"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:984
msgid "Enable zero_cond_t for Qwen Image (--qwen-image-zero-cond-t)."
msgstr "Увімкнути zero_cond_t для Qwen Image (--qwen-image-zero-cond-t)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:989
msgid "Flow Shift"
msgstr "Зсув Flow"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:990
msgid "Shift value for Flow models (e.g. 3 for Qwen Image). 0 = auto."
msgstr ""
"Значення зсуву для моделей Flow (наприклад, 3 для Qwen Image). 0 = "
"автоматично."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:995
msgid "Prediction Type"
msgstr "Тип передбачення"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:996
msgid "Override the model's prediction type (--prediction)."
msgstr "Перевизначити тип передбачення моделі (--prediction)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1002
msgid "Weight Type"
msgstr "Тип ваг"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1004
msgid ""
"Override the model weight type (--type). Model default uses the type stored "
"in the weight file."
msgstr ""
"Перевизначити тип ваг моделі (--type). За замовчуванням використовується "
"тип, збережений у файлі ваг."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1008
msgid "Model default"
msgstr "За замовчуванням для моделі"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1029
msgid "Cache Mode"
msgstr "Режим кешування"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1030
msgid "Caching method for faster inference (--cache-mode)."
msgstr "Метод кешування для швидшого виконання моделі (--cache-mode)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1036
msgid "RNG"
msgstr "Генератор випадкових чисел"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1037
msgid ""
"Random number generator backend (--rng). 'cuda' matches A1111, 'cpu' matches "
"ComfyUI."
msgstr ""
"Бекенд генератора випадкових чисел (--rng). 'cuda' відповідає A1111, 'cpu' — "
"ComfyUI."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1043
msgid "Extra CLI Arguments"
msgstr "Додаткові аргументи CLI"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1044
msgid ""
"Additional command-line arguments passed verbatim to sd-cli / sd-server. One "
"per line, e.g. '--vae-tile-size 64x64'."
msgstr ""
"Додаткові аргументи командного рядка, які без змін передаються до sd-cli / "
"sd-server. По одному на рядок, наприклад '--vae-tile-size 64x64'."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1660
#: src/handlers/tts/kokoro_handler.py:196
msgid "Finalizing model file"
msgstr "Завершення підготовки файлу моделі"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:2407
msgid "Runs local Stable Diffusion models for image generation"
msgstr ""

#: src/handlers/interfaces/api_handler.py:73
#: src/handlers/interfaces/gui_api_handler.py:33
msgid ""
"API key required to authenticate requests (leave empty to disable "
"authentication)"
msgstr ""
"Для автентифікації запитів потрібен ключ API (залиште порожнім, щоб вимкнути "
"автентифікацію)"

#: src/handlers/interfaces/api_handler.py:79
#: src/handlers/interfaces/gui_api_handler.py:39
#: src/handlers/interfaces/mcp_interface.py:116
msgid "Host"
msgstr "Хост"

#: src/handlers/interfaces/api_handler.py:80
#: src/handlers/interfaces/gui_api_handler.py:40
msgid "Host address to bind the API server to"
msgstr "Адреса хоста, на якому слід запустити API-сервер"

#: src/handlers/interfaces/api_handler.py:85
#: src/handlers/interfaces/gui_api_handler.py:45
#: src/handlers/interfaces/mcp_interface.py:122
msgid "Port"
msgstr "Порт"

#: src/handlers/interfaces/api_handler.py:86
#: src/handlers/interfaces/gui_api_handler.py:46
msgid "Port to bind the API server to"
msgstr "Порт, на якому слід запустити API-сервер"

#: src/handlers/interfaces/api_handler.py:94
msgid "Enable API logging"
msgstr "Увімкнути журналювання API"

