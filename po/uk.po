msgid "Context Threshold"
msgstr "Поріг контексту"

#: src/handlers/memory/agentic_memory_handler.py:72
msgid "Minimum similarity for auto-adding to context (0-1)"
msgstr "Мінімальна схожість для автоматичного додавання до контексту (0-1)"

#: src/handlers/memory/agentic_memory_handler.py:73
