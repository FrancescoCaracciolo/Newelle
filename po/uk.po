#: src/handlers/memory/long_term_memory_handler.py:225
#: src/ui/skill_creator.py:605
msgid "Open Folder"
msgstr "Відкрити папку"

#: src/handlers/memory/agentic_memory_handler.py:71
#: src/handlers/memory/llamaindex_memory_handler.py:47
