msgstr "Розмір фрагмента"

#: src/handlers/memory/agentic_memory_handler.py:74
msgid "Maximum characters per memory chunk"
msgstr "Максимальна кількість символів у фрагменті пам’яті"

#: src/handlers/memory/agentic_memory_handler.py:75
msgid "Update Frequency"
msgstr "Частота оновлення"

#: src/handlers/memory/agentic_memory_handler.py:75
msgid "Number of messages between automatic memory consolidation (0=disabled)"
msgstr ""
"Кількість повідомлень між автоматичними узагальненнями пам’яті (0 = вимкнено)"

#: src/handlers/memory/agentic_memory_handler.py:76
msgid "Extract Frequency"
msgstr "Частота вилучення"

#: src/handlers/memory/agentic_memory_handler.py:76
msgid ""
"Number of messages between automatic memory extractions (0=disabled, only "
"manual tool usage)"
msgstr ""
"Кількість повідомлень між автоматичними вилученнями даних у пам’ять (0 = "
"вимкнено, лише ручне використання інструмента)"

#: src/handlers/memory/agentic_memory_handler.py:77
msgid "Auto-add to Context"
msgstr "Автоматично додавати до контексту"

#: src/handlers/memory/agentic_memory_handler.py:77
msgid "Automatically add relevant memories to the conversation context"
msgstr "Автоматично додавати доречні спогади до контексту розмови"

#: src/handlers/memory/agentic_memory_handler.py:78
msgid "Store Interactions"
msgstr "Зберігати взаємодії"

#: src/handlers/memory/agentic_memory_handler.py:78
msgid "Store user interactions in separate file for vector search"
msgstr ""
"Зберігати взаємодії з користувачем в окремому файлі для векторного пошуку"

#: src/handlers/memory/agentic_memory_handler.py:79
msgid "Always add main memory to prompt"
msgstr "Завжди додавати основну пам’ять до промпту"

#: src/handlers/memory/agentic_memory_handler.py:79
msgid ""
"This option will always add consolidated memory to prompt in any request"
msgstr ""
"Цей параметр завжди додає узагальнену пам’ять до промпту кожного запиту"

#: src/handlers/memory/agentic_memory_handler.py:80
msgid "Extract Prompt"
msgstr "Промпт для вилучення"

#: src/handlers/memory/agentic_memory_handler.py:81
#, python-brace-format
msgid ""
"Prompt for extracting important info from conversations. {user} and "
"{assistant} will be replaced."
msgstr ""
"Промпт для вилучення важливої інформації з розмов. {user} і {assistant} буде "
"замінено."

#: src/handlers/memory/agentic_memory_handler.py:83
msgid "Consolidate Prompt"
msgstr "Промпт для узагальнення"

#: src/handlers/memory/agentic_memory_handler.py:84
#, python-brace-format
msgid ""
"Prompt for memory consolidation. {conversations} and {existing_memories} "
"will be replaced."
msgstr ""
"Промпт для узагальнення пам’яті. {conversations} і {existing_memories} буде "
"замінено."

#: src/handlers/memory/llamaindex_memory_handler.py:46
#: src/handlers/memory/user_summary_handler.py:27
msgid "Reset the memory"
msgstr "Скинути пам’ять"

#: src/handlers/memory/llamaindex_memory_handler.py:47
msgid "Minimum similarity for retrieved memories"
msgstr "Мінімальна подібність для отриманих спогадів"

#: src/handlers/memory/llamaindex_memory_handler.py:48
msgid "Max Memories"
msgstr "Максимум спогадів"

#: src/handlers/memory/llamaindex_memory_handler.py:48
msgid "Maximum number of memories to retrieve"
msgstr "Максимальна кількість спогадів для отримання"

#: src/handlers/memory/long_term_memory_handler.py:154
msgid "Shared memory"
msgstr "Спільна пам’ять"

#: src/handlers/memory/long_term_memory_handler.py:155
#, python-brace-format
msgid "Private memory of {profile}"
msgstr "Особиста пам’ять профілю {profile}"

#: src/handlers/memory/long_term_memory_handler.py:162
msgid "Keep this memory private for this profile"
msgstr "Зберігати цю пам’ять приватною для цього профілю"

#: src/handlers/memory/long_term_memory_handler.py:163
#, python-brace-format
msgid ""
"The profile \"{profile}\" uses its own memories and summary, isolated from "
"the shared memory used by other profiles"
msgstr ""
"Профіль «{profile}» використовує власні спогади й підсумок, ізольовані від "
"спільної пам’яті, якою користуються інші профілі"

#: src/handlers/memory/long_term_memory_handler.py:166
msgid "Automatic Retrieval"
msgstr "Автоматичне отримання"

#: src/handlers/memory/long_term_memory_handler.py:167
msgid ""
"When to search old memories and add them to the prompt. The user summary is "
"not affected"
msgstr ""
"Коли шукати старі спогади й додавати їх до промпту. Підсумок про користувача "
"не змінюється"

#: src/handlers/memory/long_term_memory_handler.py:168
msgid "On every message"
msgstr "У кожному повідомленні"

#: src/handlers/memory/long_term_memory_handler.py:168
msgid "Only when the assistant uses the recall tool"
msgstr "Лише коли асистент використовує інструмент пригадування"

#: src/handlers/memory/long_term_memory_handler.py:171
#: src/handlers/rag/llamaindex_handler.py:45
msgid "Context Messages"
msgstr "Повідомлення контексту"

#: src/handlers/memory/long_term_memory_handler.py:172
msgid "Number of previous messages also used to search memories"
msgstr ""
"Кількість попередніх повідомлень, які також використовуються для пошуку "
"спогадів"

#: src/handlers/memory/long_term_memory_handler.py:175
msgid "Include User Summary"
msgstr "Додавати підсумок про користувача"

#: src/handlers/memory/long_term_memory_handler.py:176
msgid "Add the short summary of the user to every prompt"
msgstr "Додавати короткий підсумок про користувача до кожного промпту"

#: src/handlers/memory/long_term_memory_handler.py:177
#: src/ui/widgets/memory_mini_app.py:29
msgid "Facts"
msgstr "Факти"

#: src/handlers/memory/long_term_memory_handler.py:177
msgid ""
"Durable facts about the user, extracted automatically or saved by the "
"assistant"
msgstr ""
"Стійкі факти про користувача, автоматично вилучені або збережені асистентом"

#: src/handlers/memory/long_term_memory_handler.py:178
msgid "Facts to Recall"
msgstr "Факти для пригадування"

#: src/handlers/memory/long_term_memory_handler.py:179
msgid ""
"Maximum number of facts added to the prompt (0 = never add facts "
"automatically)"
msgstr ""
"Максимальна кількість фактів, що додаються до промпту (0 = ніколи не "
"додавати факти автоматично)"

#: src/handlers/memory/long_term_memory_handler.py:181
msgid "Facts Minimum Relevance"
msgstr "Мінімальна доречність фактів"

#: src/handlers/memory/long_term_memory_handler.py:182
msgid ""
"Minimum relevance, after decay, for a fact to be recalled (0 = no threshold)"
msgstr ""
"Мінімальна доречність факту після згасання, за якої його буде пригадано (0 = "
"без порогу)"

#: src/handlers/memory/long_term_memory_handler.py:184
msgid "Facts Half-life (days)"
msgstr "Період напіврозпаду фактів (у днях)"

#: src/handlers/memory/long_term_memory_handler.py:185
msgid ""
"Days after which an unused fact of average importance loses half of its "
"strength"
msgstr ""
"Кількість днів, після якої сила невикористаного факту середньої важливості "
"зменшується вдвічі"

#: src/handlers/memory/long_term_memory_handler.py:188
#: src/ui/widgets/memory_mini_app.py:30
msgid "Conversations"
msgstr "Розмови"

#: src/handlers/memory/long_term_memory_handler.py:188
msgid "Past user/assistant exchanges"
msgstr "Попередні обміни повідомленнями між користувачем і асистентом"

#: src/handlers/memory/long_term_memory_handler.py:189
msgid "Store Conversations"
msgstr "Зберігати розмови"

#: src/handlers/memory/long_term_memory_handler.py:190
msgid "Save every exchange so it can be recalled later"
msgstr ""
"Зберігати кожен обмін повідомленнями, щоб його можна було пригадати пізніше"

#: src/handlers/memory/long_term_memory_handler.py:191
msgid "Conversations to Recall"
msgstr "Розмови для пригадування"

#: src/handlers/memory/long_term_memory_handler.py:192
msgid ""
"Maximum number of past exchanges added to the prompt (0 = never add them "
"automatically)"
msgstr ""
"Максимальна кількість попередніх обмінів повідомленнями, що додаються до "
"промпту (0 = ніколи не додавати їх автоматично)"

#: src/handlers/memory/long_term_memory_handler.py:194
msgid "Conversations Minimum Relevance"
msgstr "Мінімальна доречність розмов"

#: src/handlers/memory/long_term_memory_handler.py:195
msgid ""
"Minimum relevance, after decay, for an exchange to be recalled (0 = no "
"threshold)"
msgstr ""
"Мінімальна доречність обміну повідомленнями після згасання, за якої його "
"буде пригадано (0 = без порогу)"

#: src/handlers/memory/long_term_memory_handler.py:197
msgid "Conversations Half-life (days)"
msgstr "Період напіврозпаду розмов (у днях)"

#: src/handlers/memory/long_term_memory_handler.py:198
msgid "Days after which an unused exchange loses half of its strength"
msgstr ""
"Кількість днів, після якої сила невикористаного обміну повідомленнями "
"зменшується вдвічі"

#: src/handlers/memory/long_term_memory_handler.py:201
msgid "Summary and Extraction"
msgstr "Підсумок і вилучення"

#: src/handlers/memory/long_term_memory_handler.py:201
msgid "Periodic update of the user summary and of the facts"
msgstr "Періодичне оновлення підсумку про користувача й фактів"

#: src/handlers/memory/long_term_memory_handler.py:202
msgid "Update Every"
msgstr "Оновлювати кожні"

#: src/handlers/memory/long_term_memory_handler.py:203
msgid ""
"Number of messages between summary updates and fact extractions (0 = "
"disabled)"
msgstr ""
"Кількість повідомлень між оновленнями підсумку й вилученнями фактів (0 = "
"вимкнено)"

#: src/handlers/memory/long_term_memory_handler.py:205
msgid "Summary Length"
msgstr "Довжина підсумку"

#: src/handlers/memory/long_term_memory_handler.py:206
msgid "Maximum number of words of the user summary"
msgstr "Максимальна кількість слів у підсумку про користувача"

#: src/handlers/memory/long_term_memory_handler.py:207
msgid "Extraction Prompt"
msgstr "Промпт для вилучення"

#: src/handlers/memory/long_term_memory_handler.py:208
#, python-brace-format
msgid ""
"Prompt used to update the summary and extract facts. {summary}, "
"{known_facts}, {conversation} and {max_words} are replaced"
msgstr ""
"Промпт для оновлення підсумку й вилучення фактів. {summary}, {known_facts}, "
"{conversation} і {max_words} буде замінено"

#: src/handlers/memory/long_term_memory_handler.py:211
msgid "Decay"
msgstr "Згасання"

#: src/handlers/memory/long_term_memory_handler.py:211
msgid "How old memories fade over time"
msgstr "Як старі спогади з часом втрачають силу"

#: src/handlers/memory/long_term_memory_handler.py:212
msgid "Decay Influence"
msgstr "Вплив згасання"

#: src/handlers/memory/long_term_memory_handler.py:213
msgid ""
"How much the strength of a memory affects its relevance (0 = decay is "
"ignored)"
msgstr ""
"Наскільки сила спогаду впливає на його доречність (0 = згасання ігнорується)"

#: src/handlers/memory/long_term_memory_handler.py:215
msgid "Archive Threshold"
msgstr "Поріг архівування"

#: src/handlers/memory/long_term_memory_handler.py:216
msgid ""
"Memories weaker than this are archived: they are no longer recalled "
