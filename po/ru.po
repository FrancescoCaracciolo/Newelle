msgid "Only expose enabled tools"
msgstr "Показывать только включённые инструменты"

#: src/handlers/interfaces/mcp_interface.py:139
msgid ""
"Expose only the tools that are currently enabled in Nyarch Assistant; tools "
"disabled in the app are hidden from MCP clients"
msgstr ""
